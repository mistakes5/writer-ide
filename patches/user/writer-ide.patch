diff --git a/src/vs/workbench/contrib/writer/browser/writer.contribution.ts b/src/vs/workbench/contrib/writer/browser/writer.contribution.ts
new file mode 100644
index 00000000..4b9dcab1
--- /dev/null
+++ b/src/vs/workbench/contrib/writer/browser/writer.contribution.ts
@@ -0,0 +1,59 @@
+/*---------------------------------------------------------------------------------------------
+ *  Writer-first defaults for writer-ide.
+ *  Kept in one new file so upstream VS Code rebases never conflict with it.
+ *--------------------------------------------------------------------------------------------*/
+
+import { IConfigurationRegistry, Extensions } from '../../../../platform/configuration/common/configurationRegistry.js';
+import { Registry } from '../../../../platform/registry/common/platform.js';
+
+const proseEditor = {
+	'editor.wordWrap': 'on',
+	'editor.lineNumbers': 'off',
+	'editor.glyphMargin': false,
+	'editor.folding': false,
+	'editor.minimap.enabled': false,
+	'editor.renderLineHighlight': 'none',
+	'editor.guides.indentation': false,
+	'editor.occurrencesHighlight': 'off',
+	'editor.selectionHighlight': false,
+	'editor.unicodeHighlight.ambiguousCharacters': false,
+	'editor.quickSuggestions': { other: 'off', comments: 'off', strings: 'off' },
+	'editor.wordBasedSuggestions': 'off',
+	'editor.suggestOnTriggerCharacters': false,
+	'editor.fontFamily': '"Iowan Old Style", Charter, Georgia, serif',
+	'editor.fontSize': 17,
+	'editor.lineHeight': 1.7,
+	'editor.padding.top': 32,
+	'editor.cursorBlinking': 'smooth',
+	'editor.cursorSmoothCaretAnimation': 'on',
+};
+
+Registry.as<IConfigurationRegistry>(Extensions.Configuration).registerDefaultConfigurations([{
+	source: { id: 'writer-ide', displayName: 'Writer defaults' },
+	overrides: {
+		// Prose is the default document type.
+		'files.defaultLanguage': 'markdown',
+		'files.autoSave': 'afterDelay',
+		'[markdown]': proseEditor,
+		'[plaintext]': proseEditor,
+
+		// Quiet chrome around the page.
+		'editor.minimap.enabled': false,
+		'editor.stickyScroll.enabled': false,
+		'breadcrumbs.enabled': false,
+		'workbench.editor.empty.hint': 'hidden',
+		'workbench.tips.enabled': false,
+		'workbench.startupEditor': 'none',
+		'extensions.ignoreRecommendations': true,
+
+		// The built-in coding agent stays off; our own writing assistance replaces it.
+		// The integrated terminal stays available (Claude Code etc.).
+		'chat.disableAIFeatures': true,
+
+		// Writers open folders of readings and drafts, not code to audit: no
+		// Restricted Mode, no trust prompt, and the terminal always starts.
+		'security.workspace.trust.enabled': false,
+		// The right side bar would only hold an empty chat view.
+		'workbench.secondarySideBar.defaultVisibility': 'hidden',
+	}
+}]);
