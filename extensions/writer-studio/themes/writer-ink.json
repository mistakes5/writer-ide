	"tokenColors": [
		{
			"name": "Headings",
			"scope": [
				"markup.heading",
				"markup.heading entity.name",
				"entity.name.section.markdown"
			],
			"settings": { "foreground": "#c9a55f", "fontStyle": "bold" }
		},
		{
			"name": "Heading marks",
			"scope": "punctuation.definition.heading.markdown",
			"settings": { "foreground": "#7d6a44", "fontStyle": "" }
		},
		{
			"name": "Strong",
			"scope": "markup.bold",
			"settings": { "foreground": "#f2ede2", "fontStyle": "bold" }
		},
		{
			"name": "Emphasis",
			"scope": "markup.italic",
			"settings": { "fontStyle": "italic" }
		},
		{
			"name": "Strong emphasis",
			"scope": ["markup.bold markup.italic", "markup.italic markup.bold"],
			"settings": { "fontStyle": "bold italic" }
		},
		{
			"name": "Struck text",
			"scope": "markup.strikethrough",
			"settings": { "foreground": "#8a8577", "fontStyle": "strikethrough" }
		},
		{
			"name": "Emphasis marks",
			"scope": [
				"punctuation.definition.bold.markdown",
				"punctuation.definition.italic.markdown",
				"punctuation.definition.strikethrough.markdown"
			],
			"settings": { "foreground": "#6b665a" }
		},
		{
			"name": "Block quotes",
			"scope": "markup.quote",
			"settings": { "foreground": "#a9b59c", "fontStyle": "italic" }
		},
		{
			"name": "Quote marks",
			"scope": "punctuation.definition.quote.begin.markdown",
			"settings": { "foreground": "#5f6b57", "fontStyle": "" }
		},
		{
			"name": "List marks",
			"scope": [
				"punctuation.definition.list.begin.markdown",
				"beginning.punctuation.definition.list.markdown"
			],
			"settings": { "foreground": "#a88c56" }
		},
		{
			"name": "Link text",
			"scope": [
				"string.other.link.title.markdown",
				"string.other.link.description.markdown",
				"meta.link.inline.markdown string.other.link"
			],
			"settings": { "foreground": "#9fb08f" }
		},
		{
			"name": "Link targets and references",
			"scope": [
				"markup.underline.link",
				"constant.other.reference.link.markdown",
				"meta.link.reference.def.markdown",
				"string.other.link.description.title.markdown"
			],
			"settings": { "foreground": "#7f8c74" }
		},
		{
			"name": "Link punctuation",
			"scope": [
				"punctuation.definition.link.markdown",
				"punctuation.definition.link.title.begin.markdown",
				"punctuation.definition.link.title.end.markdown",
				"punctuation.definition.link.description.begin.markdown",
				"punctuation.definition.link.description.end.markdown",
				"punctuation.definition.metadata.markdown",
				"punctuation.definition.constant.markdown",
				"punctuation.separator.key-value.markdown"
			],
			"settings": { "foreground": "#6b665a" }
		},
		{
			"name": "Inline code and code blocks",
			"scope": [
				"markup.inline.raw",
				"markup.fenced_code.block",
				"markup.raw.block"
			],
			"settings": { "foreground": "#c2b596" }
		},
		{
			"name": "Code fence marks",
			"scope": [
				"punctuation.definition.raw.markdown",
				"punctuation.definition.markdown",
				"fenced_code.block.language"
			],
			"settings": { "foreground": "#777266" }
		},
		{
			"name": "Section breaks",
			"scope": "meta.separator.markdown",
			"settings": { "foreground": "#6b665a" }
		},
		{
			"name": "Front matter",
			"scope": [
				"meta.embedded.block.frontmatter",
				"punctuation.definition.frontmatter"
			],
			"settings": { "foreground": "#8a8577" }
		},
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#8a8577", "fontStyle": "italic" }
		},
		{
			"name": "Strings",
			"scope": "string",
			"settings": { "foreground": "#9fb08f" }
		},
		{
			"name": "Numbers and constants",
			"scope": ["constant.numeric", "constant.language", "constant.character"],
			"settings": { "foreground": "#d1a04a" }
		},
		{
			"name": "Keywords",
			"scope": ["keyword", "storage"],
			"settings": { "foreground": "#c9a55f" }
		},
		{
			"name": "Keys and tags",
			"scope": [
				"support.type.property-name",
				"entity.name.tag",
				"entity.other.attribute-name"
			],
			"settings": { "foreground": "#9fb08f" }
		},
		{
			"name": "Names",
			"scope": ["entity.name.function", "entity.name.type", "support.function"],
			"settings": { "foreground": "#b7c6a9" }
		},
		{
			"name": "Invalid",
			"scope": "invalid",
			"settings": { "foreground": "#d0705f" }
		}
	]
}
